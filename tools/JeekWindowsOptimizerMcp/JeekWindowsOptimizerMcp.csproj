<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekWindowsOptimizerMcp</AssemblyName>
    <RootNamespace>JeekWindowsOptimizerMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Publish as a single file into Runtime\ so the app root keeps only
         JeekWindowsOptimizer.exe among binaries; startup installs that file at the stable
         per-user path under LocalAppData. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\bin\Runtime</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names and instance registry, shared with the app. -->
    <Compile Include="..\..\JeekWindowsOptimizer\Mcp\McpPipeNames.cs" Link="McpPipeNames.cs" />
    <Compile Include="..\..\JeekWindowsOptimizer\Mcp\McpAdapterRegistry.cs" Link="McpAdapterRegistry.cs" />
  </ItemGroup>

</Project>
