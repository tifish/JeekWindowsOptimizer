<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekWindowsOptimizerMcp</AssemblyName>
    <RootNamespace>JeekWindowsOptimizerMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ships beside the app: the adapter derives the instance id from its own folder.
         Single-file keeps the runtimeconfig inside the exe, so NetBeauty never patches
         it and the main app's next build cannot fail over a locked libloader.dll. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>..\..\bin</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names, shared with the app. -->
    <Compile Include="..\..\JeekWindowsOptimizer\Mcp\McpPipeNames.cs" Link="McpPipeNames.cs" />
  </ItemGroup>

</Project>
