<Window
    x:Class="JeekWindowsOptimizer.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:Jeek.Avalonia.Localization"
    xmlns:local="using:JeekWindowsOptimizer"
    xmlns:startup="using:JeekWindowsOptimizer.Startup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WindowTitle}"
    Width="1220"
    Height="900"
    MinWidth="920"
    MinHeight="620"
    d:DesignHeight="760"
    d:DesignWidth="1220"
    x:DataType="local:MainViewModel"
    Icon="/Assets/App.ico"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppCanvasBackgroundBrush}"
    KeyDown="Window_OnKeyDown"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
            <x:Double x:Key="TabItemMinHeight">34</x:Double>
            <Thickness x:Key="TabItemHeaderMargin">0</Thickness>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Layered Fluent 2 Dark Surfaces -->
                    <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="#FF16181C" />
                    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#FF1C1F24" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF23272E" />
                    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FF2A2F38" />
                    <SolidColorBrush x:Key="CardPressedBackgroundBrush" Color="#FF1E2228" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#FF1A1D22" />
                    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF303540" />
                    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#FF454D5C" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#FF2A2E37" />

                    <!-- Text Hierarchy -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F4F8" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF9DA5B4" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF737C8C" />

                    <!-- Accent System -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF68CCFF" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF38B2F0" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF07131D" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#1F4CC2FF" />
                    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#2E4CC2FF" />
                    <SolidColorBrush x:Key="AccentTintBorderBrush" Color="#4D4CC2FF" />
                    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#18FFFFFF" />

                    <!-- Fluent AccentButton overrides -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF4CC2FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF68CCFF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF38B2F0" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF2F343D" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF07131D" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF07131D" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF07131D" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF6C7483" />

                    <!-- Semantic Badges & Status -->
                    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1D34D399" />
                    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#4034D399" />
                    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#FF5EEAD4" />
                    <SolidColorBrush x:Key="SuccessDotBrush" Color="#FF34D399" />

                    <SolidColorBrush x:Key="WarningTintBrush" Color="#22FBBF24" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#48FBBF24" />
                    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFFCD34D" />
                    <SolidColorBrush x:Key="WarningBarBrush" Color="#FFF59E0B" />

                    <SolidColorBrush x:Key="DangerTintBrush" Color="#24F87171" />
                    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4AF87171" />
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFCA5A5" />
                    <SolidColorBrush x:Key="DangerBarBrush" Color="#FFEF4444" />

                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NeutralBadgeBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#FFA8B0BE" />

                    <!-- Icon & Tool Run Hint -->
                    <SolidColorBrush x:Key="TitleBarIconForegroundBrush" Color="#FFDCE2EC" />
                    <SolidColorBrush x:Key="ToolRunHintBackgroundBrush" Color="#FF2D323B" />
                    <SolidColorBrush x:Key="ToolRunHintBorderBrush" Color="#FF3E4552" />
                    <SolidColorBrush x:Key="ToolRunHintForegroundBrush" Color="#FFE4E8F0" />

                    <!-- Expander clean flat header -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#18000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="#22000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#00000000" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentPadding">0,8,0,6</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">6,0,2,0</Thickness>
                    <x:Double x:Key="ExpanderMinHeight">38</x:Double>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- Layered Fluent 2 Light Surfaces -->
                    <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="#FFF2F4F8" />
                    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#FFFAFBFD" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="CardPressedBackgroundBrush" Color="#FFF1F5F9" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#FFF0F3F8" />
                    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0D0F172A" />
                    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#170F172A" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE2E7F0" />
                    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#FFC6D0DF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#FFE4E9F1" />

                    <!-- Text Hierarchy -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF16191F" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5A6475" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF838D9E" />

                    <!-- Accent System -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF005AA8" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF004B8D" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#140067C0" />
                    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#200067C0" />
                    <SolidColorBrush x:Key="AccentTintBorderBrush" Color="#3D0067C0" />
                    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#120067C0" />

                    <!-- Proper Win11 Primary Accent Button in Light Mode -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0067C0" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF005AA8" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF004B8D" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FFE5E9F0" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF9AA3B2" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF005FB0" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF005299" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF004582" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#FFDCE1EA" />

                    <!-- Semantic Badges & Status -->
                    <SolidColorBrush x:Key="SuccessTintBrush" Color="#FFECFDF5" />
                    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FFA7F3D0" />
                    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#FF047857" />
                    <SolidColorBrush x:Key="SuccessDotBrush" Color="#FF10B981" />

                    <SolidColorBrush x:Key="WarningTintBrush" Color="#FFFFFBEB" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFFDE68A" />
                    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFB45309" />
                    <SolidColorBrush x:Key="WarningBarBrush" Color="#FFD97706" />

                    <SolidColorBrush x:Key="DangerTintBrush" Color="#FFFEF2F2" />
                    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFFECACA" />
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFB91C1C" />
                    <SolidColorBrush x:Key="DangerBarBrush" Color="#FFDC2626" />

                    <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#FFF0F3F8" />
                    <SolidColorBrush x:Key="NeutralBadgeBorderBrush" Color="#FFE2E7F0" />
                    <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#FF5A6475" />

                    <!-- Icon & Tool Run Hint -->
                    <SolidColorBrush x:Key="TitleBarIconForegroundBrush" Color="#FF2D3440" />
                    <SolidColorBrush x:Key="ToolRunHintBackgroundBrush" Color="#FFF5F7FB" />
                    <SolidColorBrush x:Key="ToolRunHintBorderBrush" Color="#FFDCE2EC" />
                    <SolidColorBrush x:Key="ToolRunHintForegroundBrush" Color="#FF2B3340" />

                    <!-- Expander clean flat header -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#0A0F172A" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#140F172A" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="#0D0F172A" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="#160F172A" />
                    <SolidColorBrush x:Key="ExpanderChevronBackgroundDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrushDisabled" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#00000000" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentPadding">0,8,0,6</Thickness>
                    <Thickness x:Key="ExpanderHeaderPadding">6,0,2,0</Thickness>
                    <x:Double x:Key="ExpanderMinHeight">38</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Reusable Fluent Glyph -->
        <Style Selector="TextBlock.glyph">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Top Navigation TabStrip -->
        <Style Selector="TabStrip.app-nav-tabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Height" Value="2.5" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:selected TextBlock.tab-icon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs Border.tab-badge">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs TabItem:selected Border.tab-badge">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
        </Style>
        <Style Selector="TabStrip.app-nav-tabs Border.tab-badge-warn">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Header Inline Search Box -->
        <Style Selector="TextBox.header-search">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Header Utility Icon Buttons -->
        <Style Selector="Button.titlebar-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.titlebar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        </Style>
        <Style Selector="Button.titlebar-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
        </Style>
        <Style Selector="TextBlock.titlebar-glyph-text">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarIconForegroundBrush}" />
        </Style>
        <Style Selector="Button.search-clear-inline">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.search-clear-inline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        </Style>

        <!-- Left Group Navigation Rail (Win11 NavigationView style) -->
        <Style Selector="ListBox.group-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem Border.nav-indicator">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:selected Border.nav-indicator">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.group-nav ListBoxItem:selected Border.nav-count-pill">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
        </Style>

        <!-- Hero & Setting Cards -->
        <Style Selector="Border.hero-card">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.setting-card">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.setting-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
        </Style>

        <!-- Semantic Banner Cards -->
        <Style Selector="Border.banner-warning">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.banner-info">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Semantic Status Pills -->
        <Style Selector="Border.status-pill">
            <Setter Property="Padding" Value="8,2.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.status-success">
            <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
        </Style>
        <Style Selector="Border.status-warning">
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        </Style>
        <Style Selector="Border.status-danger">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        </Style>
        <Style Selector="Border.status-neutral">
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralBadgeBorderBrush}" />
        </Style>
        <Style Selector="Border.status-accent">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
        </Style>

        <!-- Count Pill & Icon Tile -->
        <Style Selector="Border.count-pill">
            <Setter Property="Padding" Value="7,1.5" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.icon-tile">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.path-chip">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Primary & Toolbar Buttons -->
        <Style Selector="Button.cta-primary">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cta-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.cta-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.cta-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
        </Style>

        <Style Selector="Button.cta-compact">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cta-compact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.cta-compact:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.cta-compact:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
        </Style>

        <Style Selector="Button.toolbar-tinted">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolbar-tinted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.group-toolbar">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.group-toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
        </Style>
        <Style Selector="Button.group-toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardPressedBackgroundBrush}" />
        </Style>

        <Style Selector="Button.ghost-toolbar">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost-toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.ghost-toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
        </Style>

        <!-- Interactive Filter Pill ToggleButton -->
        <Style Selector="ToggleButton.filter-pill">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.filter-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.filter-pill:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.filter-pill:checked">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Startup Allow / Deny semantic action buttons -->
        <Style Selector="Button.startup-action">
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.startup-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
        </Style>
        <Style Selector="Button.startup-allow.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        </Style>
        <Style Selector="Button.startup-allow.active">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        </Style>
        <Style Selector="Button.startup-deny.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        </Style>
        <Style Selector="Button.startup-deny.active">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        </Style>

        <!-- Tool Card (2-column tactile card) -->
        <Style Selector="Button.tool-card">
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tool-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}" />
        </Style>
        <Style Selector="Button.tool-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardPressedBackgroundBrush}" />
        </Style>
        <Style Selector="Button.tool-card:pointerover Border.tool-run-badge">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}" />
        </Style>
        <Style Selector="Button.tool-card:pointerover TextBlock.tool-run-text">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.tool-card:disabled">
            <Setter Property="Opacity" Value="0.58" />
        </Style>

        <!-- Sleek Progress Bars -->
        <Style Selector="ProgressBar.thin-bar">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ProgressBar.thin-bar.complete">
            <Setter Property="Foreground" Value="{DynamicResource SuccessDotBrush}" />
        </Style>
        <Style Selector="ProgressBar.disk-bar">
            <Setter Property="MinHeight" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ProgressBar.disk-bar.usage-high">
            <Setter Property="Foreground" Value="{DynamicResource WarningBarBrush}" />
        </Style>
        <Style Selector="ProgressBar.disk-bar.usage-critical">
            <Setter Property="Foreground" Value="{DynamicResource DangerBarBrush}" />
        </Style>

        <!-- Dim zero-size disk text -->
        <Style Selector="TextBlock.disk-size">
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.disk-size.nonzero">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <local:MainViewModel />
    </Design.DataContext>

    <!-- Main 3-Row Shell: Fixed App Header | Workspace | Fixed Status Footer -->
    <Grid RowDefinitions="Auto * Auto">

        <!-- ==================== TOP APP HEADER BAR (Fixed height, never jumps) ==================== -->
        <Border
            x:Name="AppHeaderBar"
            Grid.Row="0"
            Padding="16,9,16,9"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="* Auto">
                <!-- Left: Primary Navigation Tabs -->
                <ScrollViewer
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                    <TabStrip
                        x:Name="MainNavigationTabs"
                        Classes="app-nav-tabs"
                        VerticalAlignment="Center"
                        SelectedIndex="{Binding SelectedTabIndex}">

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xE945;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OptimizingTabLabel}" />
                                    <Border Classes="tab-badge" IsVisible="{Binding OptimizingTabBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding OptimizingTabBadge}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xEA18;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding AntivirusTabLabel}" />
                                    <Border Classes="tab-badge" IsVisible="{Binding AntivirusTabBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding AntivirusTabBadge}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xE771;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding PersonalTabLabel}" />
                                    <Border Classes="tab-badge" IsVisible="{Binding PersonalTabBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding PersonalTabBadge}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xEDA2;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding DiskSpaceTabHeader}" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xE7E8;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding StartupTabHeader}" />
                                    <Border Classes="tab-badge-warn" IsVisible="{Binding HasStartupPending}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Text="{Binding StartupTabPendingBadge}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph tab-icon" FontSize="13.5" Text="&#xEC7A;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ToolsTabHeader}" />
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>

                    </TabStrip>
                </ScrollViewer>

                <!-- Right: Inline Search + Compact Utility Controls -->
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">

                    <TextBox
                        x:Name="SearchTextBox"
                        Width="190"
                        Classes="header-search"
                        KeyDown="SearchTextBox_OnKeyDown"
                        PlaceholderText="{l:Localize SearchWatermark}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InnerLeftContent>
                            <TextBlock
                                Margin="9,0,2,0"
                                Classes="glyph"
                                FontSize="13"
                                Foreground="{DynamicResource TertiaryTextBrush}"
                                Text="&#xE721;" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button
                                Classes="search-clear-inline"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding IsSearchActive}"
                                ToolTip.Tip="{l:Localize ClearSearch}">
                                <TextBlock
                                    Classes="glyph"
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="&#xE894;" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <Border
                        Width="1"
                        Height="18"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerBrush}" />

                    <!-- Update -->
                    <Button Classes="titlebar-icon" ToolTip.Tip="{l:Localize Update}">
                        <TextBlock Classes="titlebar-glyph-text" Text="&#xE896;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding CurrentVersionMenuHeader}" IsEnabled="False" />
                                <MenuItem Command="{Binding OpenProjectHomepageCommand}" Header="{l:Localize ProjectHomepage}" />
                                <Separator />
                                <MenuItem Command="{Binding CheckForUpdatesCommand}" Header="{l:Localize CheckForUpdates}" />
                                <MenuItem
                                    Header="{l:Localize AutoUpdate}"
                                    IsChecked="{Binding IsAutoUpdateEnabled, Mode=TwoWay}"
                                    ToggleType="CheckBox" />
                                <MenuItem Header="{l:Localize UpdateInterval}">
                                    <MenuItem
                                        Command="{Binding SetUpdateIntervalTo6HoursCommand}"
                                        GroupName="UpdateInterval"
                                        Header="{l:Localize UpdateIntervalEvery6Hours}"
                                        IsChecked="{Binding IsUpdateInterval6HoursChecked, Mode=OneWay}"
                                        ToggleType="Radio" />
                                    <MenuItem
                                        Command="{Binding SetUpdateIntervalToDailyCommand}"
                                        GroupName="UpdateInterval"
                                        Header="{l:Localize UpdateIntervalDaily}"
                                        IsChecked="{Binding IsUpdateIntervalDailyChecked, Mode=OneWay}"
                                        ToggleType="Radio" />
                                    <MenuItem
                                        Command="{Binding SetUpdateIntervalToWeeklyCommand}"
                                        GroupName="UpdateInterval"
                                        Header="{l:Localize UpdateIntervalWeekly}"
                                        IsChecked="{Binding IsUpdateIntervalWeeklyChecked, Mode=OneWay}"
                                        ToggleType="Radio" />
                                    <MenuItem
                                        Command="{Binding SetUpdateIntervalToNeverCommand}"
                                        GroupName="UpdateInterval"
                                        Header="{l:Localize UpdateIntervalNever}"
                                        IsChecked="{Binding IsUpdateIntervalNeverChecked, Mode=OneWay}"
                                        ToggleType="Radio" />
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Language -->
                    <Button Classes="titlebar-icon" ToolTip.Tip="{l:Localize Language}">
                        <TextBlock Classes="titlebar-glyph-text" Text="&#xE774;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem
                                    Command="{Binding SwitchToSystemLanguageCommand}"
                                    GroupName="Language"
                                    Header="{l:Localize LanguageSystem}"
                                    IsChecked="{Binding IsSystemLanguageMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding SwitchToEnglishCommand}"
                                    GroupName="Language"
                                    Header="{l:Localize en}"
                                    IsChecked="{Binding IsEnglishMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <MenuItem
                                    Command="{Binding SwitchToChineseCommand}"
                                    GroupName="Language"
                                    Header="{l:Localize zh}"
                                    IsChecked="{Binding IsChineseMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Theme -->
                    <Button Classes="titlebar-icon" ToolTip.Tip="{l:Localize Theme}">
                        <TextBlock Classes="titlebar-glyph-text" Text="{Binding CurrentThemeGlyph}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem
                                    Command="{Binding SwitchToLightThemeCommand}"
                                    GroupName="Theme"
                                    Header="{l:Localize ThemeLight}"
                                    IsChecked="{Binding IsLightThemeMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <MenuItem
                                    Command="{Binding SwitchToDarkThemeCommand}"
                                    GroupName="Theme"
                                    Header="{l:Localize ThemeDark}"
                                    IsChecked="{Binding IsDarkThemeMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <MenuItem
                                    Command="{Binding SwitchToSystemThemeCommand}"
                                    GroupName="Theme"
                                    Header="{l:Localize ThemeSystem}"
                                    IsChecked="{Binding IsSystemThemeMenuChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Settings -->
                    <Button Classes="titlebar-icon" ToolTip.Tip="{l:Localize Settings}">
                        <TextBlock Classes="titlebar-glyph-text" Text="&#xE713;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{l:Localize StorageMode}" IsEnabled="False" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding SwitchToDefaultStorageCommand}"
                                    GroupName="StorageMode"
                                    Header="{l:Localize StorageModeDefault}"
                                    IsChecked="{Binding IsStorageModeDefaultChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <MenuItem
                                    Command="{Binding SwitchToPortableStorageCommand}"
                                    GroupName="StorageMode"
                                    Header="{l:Localize StorageModePortable}"
                                    IsChecked="{Binding IsStorageModePortableChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                                <MenuItem
                                    Click="StorageModeCustom_OnClick"
                                    GroupName="StorageMode"
                                    Header="{l:Localize StorageModeCustom}"
                                    IsChecked="{Binding IsStorageModeCustomChecked, Mode=OneWay}"
                                    ToggleType="Radio" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="1">

            <!-- ========== 1. OPTIMIZATION TABS (Optimizing / Antivirus / Personal) ========== -->
            <Grid ColumnDefinitions="228 *" IsVisible="{Binding IsOptimizationTabSelected}">
                <!-- Left Rail -->
                <Border
                    Grid.Column="0"
                    Padding="12,16,10,12"
                    Background="{DynamicResource SurfaceSidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="10,0,0,10"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TertiaryTextBrush}"
                            Text="{l:Localize GroupsNavTitle}" />
                        <ListBox
                            x:Name="OptimizationGroupNavigation"
                            Classes="group-nav"
                            ItemsSource="{Binding GroupNavItems}"
                            SelectedItem="{Binding SelectedGroupNavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupNavItem">
                                    <Grid ColumnDefinitions="Auto * Auto" Margin="0,1">
                                        <Border
                                            Grid.Column="0"
                                            Classes="nav-indicator"
                                            Width="3"
                                            Height="16"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Padding="0,7"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Border
                                            Grid.Column="2"
                                            Classes="count-pill nav-count-pill"
                                            Margin="6,0,8,0">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="{Binding DisplayCountText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Content Pane -->
                <Grid Grid.Column="1" Margin="22,16,14,0" RowDefinitions="Auto Auto *">
                    <!-- Hero Summary & Primary CTA Card -->
                    <Border Grid.Row="0" Margin="0,0,14,12" Classes="hero-card">
                        <Grid ColumnDefinitions="* Auto" RowDefinitions="Auto Auto">
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,20,0" Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{Binding SelectedTabTitle}" />
                                    <Border Classes="status-pill status-accent" IsVisible="{Binding !IsSelectedTabFullyOptimized}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding SelectedTabProgressText}" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedTabProgressPercentText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="status-pill status-success" IsVisible="{Binding IsSelectedTabFullyOptimized}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessDotBrush}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding SelectedTabProgressText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12.5"
                                    LineHeight="18"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding SelectedTabDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Grid.Row="0"
                                VerticalAlignment="Center"
                                Classes="cta-primary"
                                Command="{Binding OptimizeCheckedItems}"
                                IsEnabled="{Binding AreOptimizationItemControlsEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="glyph" FontSize="14" Text="&#xE945;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OptimizeButtonText}" />
                                </StackPanel>
                            </Button>

                            <ProgressBar
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Classes="thin-bar"
                                Classes.complete="{Binding IsSelectedTabFullyOptimized}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding SelectedTabProgressPercent}" />
                        </Grid>
                    </Border>

                    <!-- Contextual Action Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,14,10" ColumnDefinitions="* Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <ToggleButton
                                x:Name="ShowOnlyNotOptimizedToggle"
                                Classes="filter-pill"
                                IsChecked="{Binding ShowOnlyNotOptimized, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE71C;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize ShowOnlyNotOptimized}" />
                                </StackPanel>
                            </ToggleButton>

                            <Button
                                x:Name="RefreshOptimizationItemStatesButton"
                                Classes="group-toolbar"
                                Command="{Binding RefreshOptimizationItemStatesCommand}"
                                AutomationProperties.Name="{l:Localize RefreshOptimizationStatus}"
                                ToolTip.Tip="{l:Localize RefreshOptimizationStatus}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize RefreshOptimizationStatus}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-toolbar" Command="{Binding ExpandAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70D;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize ExpandAllGroups}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost-toolbar" Command="{Binding CollapseAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70E;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize CollapseAllGroups}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Group List -->
                    <ScrollViewer
                        x:Name="OptimizationContentScrollViewer"
                        Grid.Row="2"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsControl x:Name="OptimizationGroupsItemsControl" Margin="0,0,14,16" ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:OptimizationGroup">
                                    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    Text="{Binding Name}" />
                                                <Border Classes="count-pill">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ItemCount}" />
                                                </Border>
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:OptimizationItem">
                                                    <Border Classes="setting-card">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto Auto">
                                                                <CheckBox
                                                                    Grid.Column="0"
                                                                    Grid.Row="0"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    IsChecked="{Binding IsChecked}"
                                                                    IsEnabled="{Binding $parent[Window].((local:MainViewModel)DataContext).AreOptimizationItemControlsEnabled}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Cursor="Hand"
                                                                    FontSize="14.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                                    PointerPressed="OptimizationItemTitle_OnPointerPressed"
                                                                    Text="{Binding Name}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    Margin="0,5,24,0"
                                                                    FontSize="12.5"
                                                                    LineHeight="19"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="12">
                                                                <Border Classes="status-pill status-success" IsVisible="{Binding IsOptimized}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessDotBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{l:Localize Optimized}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Classes="status-pill status-neutral" IsVisible="{Binding !IsOptimized}">
                                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource NeutralBadgeForegroundBrush}" Text="{l:Localize NotOptimized}" />
                                                                </Border>
                                                                <ToggleSwitch
                                                                    VerticalAlignment="Center"
                                                                    OffContent=""
                                                                    OnContent=""
                                                                    IsChecked="{Binding IsOptimized, Mode=OneWay}"
                                                                    IsCheckedChanged="ToggleButton_OnIsCheckedChanged"
                                                                    IsEnabled="{Binding $parent[Window].((local:MainViewModel)DataContext).AreOptimizationItemControlsEnabled}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== 2. DISK SPACE TAB ========== -->
            <Grid ColumnDefinitions="228 *" IsVisible="{Binding IsDiskSpaceTabSelected}">
                <!-- Left Rail -->
                <Border
                    Grid.Column="0"
                    Padding="12,16,10,12"
                    Background="{DynamicResource SurfaceSidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="10,0,0,10"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TertiaryTextBrush}"
                            Text="{l:Localize GroupsNavTitle}" />
                        <ListBox
                            x:Name="DiskSpaceGroupNavigation"
                            Classes="group-nav"
                            ItemsSource="{Binding DiskSpaceGroupNavItems}"
                            SelectedItem="{Binding SelectedDiskSpaceGroupNavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupNavItem">
                                    <Grid ColumnDefinitions="Auto * Auto" Margin="0,1">
                                        <Border
                                            Grid.Column="0"
                                            Classes="nav-indicator"
                                            Width="3"
                                            Height="16"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Padding="0,7"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Border Grid.Column="2" Classes="count-pill nav-count-pill" Margin="6,0,8,0">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DisplayCountText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Content Pane -->
                <Grid Grid.Column="1" Margin="22,16,14,0" RowDefinitions="Auto Auto *">
                    <!-- Storage Hero Card -->
                    <Border Grid.Row="0" Margin="0,0,14,12" Classes="hero-card">
                        <Grid ColumnDefinitions="Auto * Auto" RowDefinitions="Auto Auto">
                            <Border Grid.Column="0" Grid.Row="0" Margin="0,0,14,0" Classes="icon-tile">
                                <TextBlock Classes="glyph" FontSize="18" Foreground="{DynamicResource AccentBrush}" Text="&#xEDA2;" />
                            </Border>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding SystemDriveUsageText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12.5"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding SelectedTabDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Grid.Row="0"
                                MaxWidth="360"
                                Padding="12,7"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Background="{DynamicResource AccentTintBrush}"
                                BorderBrush="{DynamicResource AccentTintBorderBrush}"
                                BorderThickness="1">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{Binding DiskSpaceSummaryText}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <ProgressBar
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Classes="disk-bar"
                                Classes.usage-high="{Binding IsSystemDriveUsageHigh}"
                                Classes.usage-critical="{Binding IsSystemDriveUsageCritical}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding SystemDriveUsedPercent}" />
                        </Grid>
                    </Border>

                    <!-- Disk Action Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,14,10" ColumnDefinitions="* Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Classes="cta-compact" Command="{Binding CleanCheckedDiskSpaceItemsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE74D;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize CleanCheckedDiskSpaceItems}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar-tinted" Command="{Binding MoveCheckedDiskSpaceItemsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE8DE;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize MoveCheckedDiskSpaceItems}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="group-toolbar" Command="{Binding ScanDiskSpaceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize ScanDiskSpace}" />
                                </StackPanel>
                            </Button>
                            <ProgressBar
                                Width="96"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Classes="thin-bar"
                                IsIndeterminate="True"
                                IsVisible="{Binding IsDiskSpaceActive}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-toolbar" Command="{Binding ExpandAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70D;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize ExpandAllGroups}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost-toolbar" Command="{Binding CollapseAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70E;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize CollapseAllGroups}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Disk Space Groups -->
                    <ScrollViewer
                        x:Name="DiskSpaceContentScrollViewer"
                        Grid.Row="2"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsControl x:Name="DiskSpaceGroupsItemsControl" Margin="0,0,14,16" ItemsSource="{Binding DiskSpaceGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DiskSpaceGroup">
                                    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{Binding Name}" />
                                                    <Border Classes="count-pill">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ItemCount}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" Spacing="2">
                                                    <Button
                                                        Classes="ghost-toolbar"
                                                        Padding="8,3"
                                                        FontSize="12"
                                                        Content="{l:Localize DiskSpaceSelectAll}"
                                                        ToolTip.Tip="{l:Localize DiskSpaceSelectionScope}"
                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectAllDiskSpaceGroupCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <Button
                                                        Classes="ghost-toolbar"
                                                        Padding="8,3"
                                                        FontSize="12"
                                                        Content="{l:Localize DiskSpaceSelectNone}"
                                                        ToolTip.Tip="{l:Localize DiskSpaceSelectionScope}"
                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SelectNoneDiskSpaceGroupCommand}"
                                                        CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.DataTemplates>
                                                <!-- Cleanup Row -->
                                                <DataTemplate DataType="local:DiskSpaceCleanupItem" x:DataType="local:DiskSpaceCleanupItem">
                                                    <Border Classes="setting-card">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto Auto Auto">
                                                                <CheckBox
                                                                    Grid.Column="0"
                                                                    Grid.Row="0"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    IsChecked="{Binding IsChecked}"
                                                                    IsEnabled="{Binding !IsBusy}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Cursor="Hand"
                                                                    FontSize="14.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                                    PointerPressed="DiskSpaceItemTitle_OnPointerPressed"
                                                                    Text="{Binding Name}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    Margin="0,5,24,0"
                                                                    FontSize="12.5"
                                                                    LineHeight="19"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Grid.Row="2"
                                                                    Margin="0,8,20,0"
                                                                    HorizontalAlignment="Left"
                                                                    Classes="status-pill status-neutral"
                                                                    Classes.status-danger="{Binding IsFailed}"
                                                                    Classes.status-success="{Binding IsDone}"
                                                                    Classes.status-accent="{Binding IsQueuedOrWorking}"
                                                                    IsVisible="{Binding HasStatusText}">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        Text="{Binding StatusText}"
                                                                        TextWrapping="Wrap" />
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                MinWidth="98"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    Classes="disk-size"
                                                                    Classes.nonzero="{Binding HasNonZeroSize}"
                                                                    FontSize="15.5"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding SizeText}" />
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource TertiaryTextBrush}"
                                                                    IsVisible="{Binding IsSlow}"
                                                                    Text="{l:Localize DiskSpaceSlowHint}" />
                                                                <Button
                                                                    HorizontalAlignment="Right"
                                                                    Classes="cta-compact"
                                                                    Command="{Binding $parent[Window].((local:MainViewModel)DataContext).CleanDiskSpaceItemCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{Binding CleanButtonText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>

                                                <!-- Hibernation Row -->
                                                <DataTemplate DataType="local:HibernationDiskSpaceItem" x:DataType="local:HibernationDiskSpaceItem">
                                                    <Border Classes="setting-card">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" Spacing="5">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14.5"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                                        Text="{Binding Name}" />
                                                                    <Border Classes="status-pill status-neutral">
                                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource NeutralBadgeForegroundBrush}" Text="{Binding ModeText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    FontSize="12.5"
                                                                    LineHeight="19"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                                <Border
                                                                    Margin="0,3,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Classes="status-pill status-neutral"
                                                                    Classes.status-danger="{Binding IsFailed}"
                                                                    Classes.status-success="{Binding IsDone}"
                                                                    IsVisible="{Binding HasStatusText}">
                                                                    <TextBlock FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    Classes="disk-size"
                                                                    Classes.nonzero="{Binding HasNonZeroSize}"
                                                                    FontSize="15.5"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding SizeText}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !IsBusy}">
                                                                    <Button
                                                                        Classes="group-toolbar"
                                                                        Content="{l:Localize HibernationReduce}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SetHibernationModeCommand}"
                                                                        CommandParameter="Reduced" />
                                                                    <Button
                                                                        Classes="group-toolbar"
                                                                        Content="{l:Localize HibernationOff}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SetHibernationModeCommand}"
                                                                        CommandParameter="Off" />
                                                                    <Button
                                                                        Classes="group-toolbar"
                                                                        Content="{l:Localize HibernationRestore}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).SetHibernationModeCommand}"
                                                                        CommandParameter="Full" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>

                                                <!-- Relocation Row -->
                                                <DataTemplate DataType="local:DiskSpaceRelocationItem" x:DataType="local:DiskSpaceRelocationItem">
                                                    <Border Classes="setting-card">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <Grid Grid.Column="0" ColumnDefinitions="Auto *" RowDefinitions="Auto Auto Auto Auto">
                                                                <CheckBox
                                                                    Grid.Column="0"
                                                                    Grid.Row="0"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    IsChecked="{Binding IsChecked}"
                                                                    IsEnabled="{Binding CanCheck}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Cursor="Hand"
                                                                    FontSize="14.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                                    PointerPressed="DiskSpaceItemTitle_OnPointerPressed"
                                                                    Text="{Binding Name}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    Margin="0,5,24,0"
                                                                    FontSize="12.5"
                                                                    LineHeight="19"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Grid.Row="2"
                                                                    Margin="0,8,20,0"
                                                                    Classes="path-chip"
                                                                    IsVisible="{Binding HasCurrentLocation}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Classes="glyph" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" Text="&#xE8B7;" />
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                                            Text="{Binding CurrentLocationText}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Grid.Row="3"
                                                                    Margin="0,6,20,0"
                                                                    HorizontalAlignment="Left"
                                                                    Classes="status-pill status-neutral"
                                                                    Classes.status-danger="{Binding IsFailed}"
                                                                    Classes.status-success="{Binding IsDone}"
                                                                    Classes.status-accent="{Binding IsQueuedOrWorking}"
                                                                    IsVisible="{Binding HasStatusText}">
                                                                    <TextBlock FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                MinWidth="110"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    Classes="disk-size"
                                                                    Classes.nonzero="{Binding HasNonZeroSize}"
                                                                    FontSize="15.5"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding SizeText}" />
                                                                <StackPanel
                                                                    HorizontalAlignment="Right"
                                                                    IsVisible="{Binding ShowMoveControls}"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                                    <ComboBox
                                                                        MinWidth="165"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12.5"
                                                                        IsEnabled="{Binding !IsBusy}"
                                                                        ItemsSource="{Binding TargetDrives}"
                                                                        SelectedItem="{Binding SelectedTargetDrive}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="local:DriveOption">
                                                                                <TextBlock Text="{Binding Label}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button
                                                                        VerticalAlignment="Center"
                                                                        Classes="cta-compact"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).MoveDiskSpaceItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{Binding MoveButtonText}"
                                                                        IsEnabled="{Binding CanMove}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="11.5"
                                                                    Foreground="{DynamicResource TertiaryTextBrush}"
                                                                    IsVisible="{Binding ShowMoveControls}"
                                                                    MaxWidth="340"
                                                                    TextWrapping="Wrap"
                                                                    Text="{Binding TargetPreview}" />
                                                                <Button
                                                                    Classes="ghost-toolbar"
                                                                    Padding="6,2"
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="12"
                                                                    Command="{Binding $parent[Window].((local:MainViewModel)DataContext).RestoreDiskSpaceItemDefaultCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding CanRestoreDefault}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <TextBlock Classes="glyph" FontSize="11" Text="&#xE7A7;" />
                                                                        <TextBlock Text="{l:Localize DiskSpaceRestoreDefault}" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource TertiaryTextBrush}"
                                                                    IsVisible="{Binding ShowNoTargetDrive}"
                                                                    Text="{l:Localize DiskSpaceNoTargetDrive}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== 3. STARTUP TAB ========== -->
            <Grid ColumnDefinitions="228 *" IsVisible="{Binding IsStartupTabSelected}">
                <!-- Left Rail -->
                <Border
                    Grid.Column="0"
                    Padding="12,16,10,12"
                    Background="{DynamicResource SurfaceSidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="10,0,0,10"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TertiaryTextBrush}"
                            Text="{l:Localize GroupsNavTitle}" />
                        <ListBox
                            x:Name="StartupGroupNavigation"
                            Classes="group-nav"
                            ItemsSource="{Binding StartupGroupNavItems}"
                            SelectedItem="{Binding SelectedStartupGroupNavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupNavItem">
                                    <Grid ColumnDefinitions="Auto * Auto" Margin="0,1">
                                        <Border
                                            Grid.Column="0"
                                            Classes="nav-indicator"
                                            Width="3"
                                            Height="16"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Padding="0,7"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <StackPanel Grid.Column="2" Margin="6,0,8,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Classes="status-pill status-warning" Padding="6,1" IsVisible="{Binding HasPending}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Text="{Binding PendingBadgeText}" />
                                            </Border>
                                            <Border Classes="count-pill nav-count-pill" IsVisible="{Binding ShowNeutralCount}">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DisplayCountText}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Content Pane -->
                <Grid Grid.Column="1" Margin="22,16,14,0" RowDefinitions="Auto Auto Auto Auto *">
                    <!-- Startup Hero Summary Card -->
                    <Border Grid.Row="0" Margin="0,0,14,10" Classes="hero-card">
                        <Grid ColumnDefinitions="Auto * Auto">
                            <Border Grid.Column="0" Margin="0,0,14,0" Classes="icon-tile">
                                <TextBlock Classes="glyph" FontSize="18" Foreground="{DynamicResource AccentBrush}" Text="&#xE7E8;" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{Binding SelectedTabTitle}" />
                                    <Border Classes="status-pill status-neutral">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Text="{l:Localize StartupStatTotal}" />
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding StartupTotalCount}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="status-pill status-warning" IsVisible="{Binding HasStartupPending}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource WarningForegroundBrush}" Text="{l:Localize StartupStatPending}" />
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Text="{Binding StartupPendingCount}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="status-pill status-danger" IsVisible="{Binding HasStartupNeedsEnforcement}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource DangerForegroundBrush}" Text="{l:Localize StartupStatEnforce}" />
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding StartupNeedsEnforcementCount}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12.5"
                                    LineHeight="18"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding SelectedTabDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Classes="cta-compact"
                                Command="{Binding EnforceStartupDecisionsCommand}"
                                IsVisible="{Binding HasStartupNeedsEnforcement}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE72E;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize StartupEnforce}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Ledger Warning Banner -->
                    <Border Grid.Row="1" Margin="0,0,14,10" Classes="banner-warning" IsVisible="{Binding HasStartupWarning}">
                        <Grid ColumnDefinitions="Auto *">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,1,10,0"
                                Classes="glyph"
                                FontSize="15"
                                Foreground="{DynamicResource WarningForegroundBrush}"
                                Text="&#xE7BA;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12.5"
                                LineHeight="18"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding StartupWarningText}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- First-run Baseline Banner -->
                    <Border Grid.Row="2" Margin="0,0,14,10" Classes="banner-info" IsVisible="{Binding IsStartupBaselinePending}">
                        <Grid ColumnDefinitions="Auto * Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,2,12,0"
                                VerticalAlignment="Top"
                                Classes="glyph"
                                FontSize="16"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="&#xE946;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                LineHeight="18"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding StartupBaselinePromptText}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="2"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Classes="cta-compact"
                                Command="{Binding AcceptStartupBaselineCommand}"
                                Content="{l:Localize StartupAcceptBaseline}" />
                        </Grid>
                    </Border>

                    <!-- Startup Action & Filter Toolbar -->
                    <Grid Grid.Row="3" Margin="0,0,14,10" ColumnDefinitions="* Auto">
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,4" Classes="group-toolbar" Command="{Binding ScanStartupCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="glyph" FontSize="12.5" Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize StartupRescan}" />
                                </StackPanel>
                            </Button>
                            <ToggleButton
                                Margin="0,0,6,4"
                                Classes="filter-pill"
                                IsChecked="{Binding ShowOnlyPendingStartupItems, Mode=TwoWay}"
                                Content="{l:Localize StartupShowOnlyPending}" />
                            <ToggleButton
                                Margin="0,0,6,4"
                                Classes="filter-pill"
                                IsChecked="{Binding ShowWindowsStartupEntries, Mode=TwoWay}"
                                Content="{l:Localize StartupShowWindowsEntries}"
                                ToolTip.Tip="{l:Localize StartupShowWindowsEntriesHint}" />
                            <ToggleButton
                                Margin="0,0,6,4"
                                Classes="filter-pill"
                                IsChecked="{Binding HideMicrosoftStartupEntries, Mode=TwoWay}"
                                Content="{l:Localize StartupHideMicrosoftEntries}" />
                            <ProgressBar
                                Width="96"
                                Margin="4,0,0,4"
                                VerticalAlignment="Center"
                                Classes="thin-bar"
                                IsIndeterminate="True"
                                IsVisible="{Binding IsStartupActive}" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="4">
                            <Button Classes="ghost-toolbar" Command="{Binding ExpandAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70D;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize ExpandAllGroups}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost-toolbar" Command="{Binding CollapseAllGroupsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70E;" />
                                    <TextBlock VerticalAlignment="Center" Text="{l:Localize CollapseAllGroups}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Startup Groups -->
                    <ScrollViewer
                        x:Name="StartupContentScrollViewer"
                        Grid.Row="4"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsControl x:Name="StartupGroupsItemsControl" Margin="0,0,14,16" ItemsSource="{Binding StartupGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="startup:StartupGroup">
                                    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    Text="{Binding Name}" />
                                                <Border Classes="count-pill">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ItemCount}" />
                                                </Border>
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="startup:StartupItem">
                                                    <Border Classes="setting-card" Padding="16,12">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <StackPanel Grid.Column="0" Margin="0,0,18,0" Spacing="4">
                                                                <WrapPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14.5"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                                        Text="{Binding DisplayName}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <Border
                                                                        Margin="0,0,6,0"
                                                                        Classes="status-pill status-warning"
                                                                        IsVisible="{Binding IsOrphaned}"
                                                                        ToolTip.Tip="{Binding ImagePath}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Classes="glyph" FontSize="10.5" Foreground="{DynamicResource WarningForegroundBrush}" Text="&#xE7BA;" />
                                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Text="{l:Localize StartupFileMissing}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border
                                                                        Classes="status-pill status-neutral"
                                                                        Classes.status-warning="{Binding IsUnsignedOrInvalid}">
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                                            Text="{Binding PublisherText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </WrapPanel>

                                                                <Grid ColumnDefinitions="Auto *" IsVisible="{Binding HasDistinctCommand}">
                                                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" Classes="glyph" FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" Text="&#xE756;" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        FontFamily="Cascadia Mono,Consolas,monospace"
                                                                        FontSize="11.5"
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        Text="{Binding CommandText}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding CommandText}" />
                                                                </Grid>

                                                                <Grid ColumnDefinitions="Auto *">
                                                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" Classes="glyph" FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" Text="&#xE8B7;" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        FontSize="11.5"
                                                                        Foreground="{DynamicResource TertiaryTextBrush}"
                                                                        Text="{Binding LocationText}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding LocationText}" />
                                                                </Grid>

                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    IsVisible="{Binding HasHookPoints}"
                                                                    Text="{Binding HookPointsText}"
                                                                    TextWrapping="Wrap" />

                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    IsVisible="{Binding DecidedOnText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                    Text="{Binding DecidedOnText}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                MinWidth="176"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Spacing="7">
                                                                <!-- Semantic Status Pill -->
                                                                <Grid HorizontalAlignment="Right">
                                                                    <Border Classes="status-pill status-success" IsVisible="{Binding IsStatusSuccess}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessDotBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding StatusText}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Classes="status-pill status-warning" IsVisible="{Binding IsStatusWarning}">
                                                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningForegroundBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                    <Border Classes="status-pill status-danger" IsVisible="{Binding IsStatusDanger}">
                                                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                    <Border Classes="status-pill status-neutral" IsVisible="{Binding IsStatusNeutral}">
                                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource NeutralBadgeForegroundBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Action Buttons -->
                                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                                    <Button
                                                                        Classes="startup-action startup-allow"
                                                                        Classes.active="{Binding IsAllowed}"
                                                                        IsEnabled="{Binding CanChoose}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).AllowStartupItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{l:Localize StartupAllow}" />
                                                                    <Button
                                                                        Classes="startup-action startup-deny"
                                                                        Classes.active="{Binding IsDenied}"
                                                                        IsEnabled="{Binding CanChoose}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).DenyStartupItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{l:Localize StartupDeny}" />
                                                                    <Button
                                                                        Classes="startup-action"
                                                                        Padding="9,5"
                                                                        IsEnabled="{Binding CanReveal}"
                                                                        Command="{Binding $parent[Window].((local:MainViewModel)DataContext).OpenStartupItemLocationCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{l:Localize StartupReveal}">
                                                                        <TextBlock Classes="glyph" FontSize="13" Text="&#xE838;" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== 4. TOOLS TAB ========== -->
            <Grid ColumnDefinitions="228 *" IsVisible="{Binding IsToolsTabSelected}">
                <!-- Left Rail -->
                <Border
                    Grid.Column="0"
                    Padding="12,16,10,12"
                    Background="{DynamicResource SurfaceSidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="10,0,0,10"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TertiaryTextBrush}"
                            Text="{l:Localize GroupsNavTitle}" />
                        <ListBox
                            x:Name="ToolGroupNavigation"
                            Classes="group-nav"
                            ItemsSource="{Binding ToolGroupNavItems}"
                            SelectedItem="{Binding SelectedToolGroupNavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:GroupNavItem">
                                    <Grid ColumnDefinitions="Auto * Auto" Margin="0,1">
                                        <Border
                                            Grid.Column="0"
                                            Classes="nav-indicator"
                                            Width="3"
                                            Height="16"
                                            Margin="2,0,8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Padding="0,7"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Border Grid.Column="2" Classes="count-pill nav-count-pill" Margin="6,0,8,0">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DisplayCountText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Content Pane -->
                <Grid Grid.Column="1" Margin="22,16,14,0" RowDefinitions="Auto *">
                    <!-- Tools Hero Header Card -->
                    <Border Grid.Row="0" Margin="0,0,14,12" Classes="hero-card">
                        <Grid ColumnDefinitions="Auto * Auto">
                            <Border Grid.Column="0" Margin="0,0,14,0" Classes="icon-tile">
                                <TextBlock Classes="glyph" FontSize="18" Foreground="{DynamicResource AccentBrush}" Text="&#xEC7A;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding SelectedTabTitle}" />
                                <TextBlock
                                    FontSize="12.5"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding SelectedTabDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <Button Classes="ghost-toolbar" Command="{Binding ExpandAllGroupsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70D;" />
                                        <TextBlock VerticalAlignment="Center" Text="{l:Localize ExpandAllGroups}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost-toolbar" Command="{Binding CollapseAllGroupsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="glyph" FontSize="11.5" Text="&#xE70E;" />
                                        <TextBlock VerticalAlignment="Center" Text="{l:Localize CollapseAllGroups}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2-Column Tool Card Grid -->
                    <ScrollViewer
                        x:Name="ToolsContentScrollViewer"
                        Grid.Row="1"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Visible">
                        <ItemsControl x:Name="ToolGroupsItemsControl" Margin="0,0,4,16" ItemsSource="{Binding ToolGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ToolGroup">
                                    <Expander HorizontalAlignment="Stretch" Margin="0,0,10,0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    Text="{Binding Name}" />
                                                <Border Classes="count-pill">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ItemCount}" />
                                                </Border>
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl Margin="0,0,-10,0" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ToolItem">
                                                    <Button Classes="tool-card" Command="{Binding RunCommand}">
                                                        <Grid ColumnDefinitions="Auto * Auto">
                                                            <!-- Tool Icon Tile -->
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="40"
                                                                Height="40"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource SubtleSurfaceBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1">
                                                                <Grid>
                                                                    <Image
                                                                        Width="24"
                                                                        Height="24"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding HasToolIcon}"
                                                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                        Source="{Binding ToolIcon}" />
                                                                    <TextBlock
                                                                        Classes="glyph"
                                                                        FontSize="17"
                                                                        Foreground="{DynamicResource AccentBrush}"
                                                                        IsVisible="{Binding !HasToolIcon}"
                                                                        Text="&#xEC7A;" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Tool Title & Description -->
                                                            <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="4">
                                                                <TextBlock
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                                    Text="{Binding Name}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    FontSize="12.5"
                                                                    LineHeight="18"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Foreground="{DynamicResource WarningForegroundBrush}"
                                                                    IsVisible="{Binding HasDisplayStatus}"
                                                                    Text="{Binding DisplayStatus}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Subtle Run Badge -->
                                                            <Border
                                                                Grid.Column="2"
                                                                Classes="tool-run-badge"
                                                                Padding="10,5"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource ToolRunHintBackgroundBrush}"
                                                                BorderBrush="{DynamicResource ToolRunHintBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                IsHitTestVisible="False">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock
                                                                        Classes="tool-run-text"
                                                                        FontSize="12"
                                                                        FontWeight="Medium"
                                                                        Foreground="{DynamicResource ToolRunHintForegroundBrush}"
                                                                        Text="{l:Localize RunTool}" />
                                                                    <TextBlock
                                                                        Classes="glyph tool-run-text"
                                                                        FontSize="10"
                                                                        Foreground="{DynamicResource ToolRunHintForegroundBrush}"
                                                                        Text="&#xE8A7;" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========== EMPTY STATE OVERLAY ========== -->
            <Border
                Margin="228,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsNoSearchResultsVisible}">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        CornerRadius="26"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            Classes="glyph"
                            FontSize="22"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="&#xE721;" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding NoResultsMessage}" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button
                            Classes="group-toolbar"
                            Command="{Binding ClearSearchCommand}"
                            Content="{l:Localize ClearSearch}"
                            IsVisible="{Binding IsSearchActive}" />
                        <Button
                            Classes="toolbar-tinted"
                            Command="{Binding ShowAllOptimizationItemsCommand}"
                            Content="{l:Localize ShowAllItems}"
                            IsVisible="{Binding CanShowShowAllButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM STATUS FOOTER BAR ==================== -->
        <Border
            x:Name="AppStatusBar"
            Grid.Row="2"
            Height="32"
            Padding="16,0"
            Background="{DynamicResource SurfaceSidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="* Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource SuccessDotBrush}"
                        IsVisible="{Binding !IsAnyOperationActive}" />
                    <Ellipse
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource AccentBrush}"
                        IsVisible="{Binding IsAnyOperationActive}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <ProgressBar
                        Width="120"
                        VerticalAlignment="Center"
                        Classes="thin-bar"
                        IsIndeterminate="True"
                        IsVisible="{Binding IsAnyOperationActive}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource TertiaryTextBrush}"
                        Text="{Binding VersionFooterText}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
