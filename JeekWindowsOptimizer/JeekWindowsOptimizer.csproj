<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <OutDir>..\bin\Runtime\</OutDir>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <CETCompat>false</CETCompat>
    <PublishDir>$(OutDir)</PublishDir>
    <!-- Dev builds are always 0.0.0.0; CI overrides with /p:Version=<commit count>. -->
    <Version>0.0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\App.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Jeek.Avalonia.Localization" Version="12.0.2" />
    <PackageReference Include="Json.Easy" Version="1.0.0" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    <!-- PowerShell begin -->
    <PackageReference Include="Microsoft.PowerShell.Commands.Diagnostics" Version="7.6.3" />
    <PackageReference Include="Microsoft.PowerShell.Commands.Management" Version="7.6.3" />
    <PackageReference Include="Microsoft.PowerShell.Commands.Utility" Version="7.6.3" />
    <PackageReference Include="Microsoft.PowerShell.ConsoleHost" Version="7.6.3" />
    <PackageReference Include="Microsoft.WSMan.Management" Version="7.6.3" />
    <!-- PowerShell otherwise resolves an affected 10.0.5 PKCS implementation. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.10" />
    <!-- PowerShell end -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JeekTools.NET\JeekTools.csproj" />
    <ProjectReference Include="..\PowerManagerAPI\PowerManagerAPI\PowerManagerAPI.csproj" />
  </ItemGroup>

  <!--
    Keep the app root clean (only JeekWindowsOptimizer.exe among binaries, alongside Runtime\,
    Data\, Tools\, scripts, etc.): all managed and native assemblies are built/published into
    Runtime\, and a standard .NET AppHost is created in the parent directory pointing to
    Runtime/JeekWindowsOptimizer.dll.
  -->
  <Target Name="CreateNestedAppHostAfterBuild"
          AfterTargets="Build"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_NestedRuntimeDir>$([System.IO.Path]::TrimEndingDirectorySeparator($([System.IO.Path]::GetFullPath('$(TargetDir)'))))</_NestedRuntimeDir>
      <_NestedAppRoot>$([System.IO.Path]::GetDirectoryName('$(_NestedRuntimeDir)'))</_NestedAppRoot>
      <_NestedRuntimeFolderName>$([System.IO.Path]::GetFileName('$(_NestedRuntimeDir)'))</_NestedRuntimeFolderName>
    </PropertyGroup>
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_NestedAppRoot)\$(AssemblyName).exe"
                   AppBinaryName="$(_NestedRuntimeFolderName)/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                   DisableCetCompat="$(_DisableCetCompat)" />
    <Delete Files="$(_NestedRuntimeDir)\$(AssemblyName).exe"
            Condition="Exists('$(_NestedRuntimeDir)\$(AssemblyName).exe')" />
  </Target>

  <Target Name="CreateNestedAppHostAfterPublish"
          AfterTargets="Publish"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PublishFullDir>$([System.IO.Path]::TrimEndingDirectorySeparator($([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))))</_PublishFullDir>
      <_PublishLeafName>$([System.IO.Path]::GetFileName('$(_PublishFullDir)'))</_PublishLeafName>
      <_PublishRuntimeDir Condition="'$(_PublishLeafName)' == 'Runtime'">$(_PublishFullDir)</_PublishRuntimeDir>
      <_PublishRuntimeDir Condition="'$(_PublishLeafName)' != 'Runtime'">$(_PublishFullDir)\Runtime</_PublishRuntimeDir>
      <_PublishAppRoot Condition="'$(_PublishLeafName)' == 'Runtime'">$([System.IO.Path]::GetDirectoryName('$(_PublishFullDir)'))</_PublishAppRoot>
      <_PublishAppRoot Condition="'$(_PublishLeafName)' != 'Runtime'">$(_PublishFullDir)</_PublishAppRoot>
    </PropertyGroup>
    <ItemGroup Condition="'$(_PublishLeafName)' != 'Runtime'">
      <_LoosePublishedFiles Include="$(_PublishFullDir)\**\*.*"
                            Exclude="$(_PublishFullDir)\Runtime\**\*.*;$(_PublishFullDir)\Data\**\*.*;$(_PublishFullDir)\Tools\**\*.*;$(_PublishFullDir)\Config\**\*.*;$(_PublishFullDir)\Logs\**\*.*;$(_PublishFullDir)\*.ps1;$(_PublishFullDir)\*.cmd" />
    </ItemGroup>
    <MakeDir Directories="$(_PublishRuntimeDir)" />
    <Move SourceFiles="@(_LoosePublishedFiles)"
          DestinationFiles="@(_LoosePublishedFiles->'$(_PublishRuntimeDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          OverwriteReadOnlyFiles="true"
          Condition="'$(_PublishLeafName)' != 'Runtime' and '@(_LoosePublishedFiles)' != ''" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_PublishAppRoot)\$(AssemblyName).exe"
                   AppBinaryName="Runtime/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                   DisableCetCompat="$(_DisableCetCompat)" />
    <Delete Files="$(_PublishRuntimeDir)\$(AssemblyName).exe"
            Condition="Exists('$(_PublishRuntimeDir)\$(AssemblyName).exe')" />
  </Target>

  <!--
    JeekWindowsOptimizerMcp is the MCP stdio adapter. Agents launch the fixed per-user
    copy under LocalAppData (or the repo-root JeekWindowsOptimizerDebugMcp.cmd which does);
    the copy inside Runtime\ is only build output that the app installs to the fixed path on
    startup — not during build.
    Publish it into Runtime\ so archives cannot omit it.

    Before overwriting, rename any existing exe (Windows allows renaming a running image). That
    way a leftover side-by-side MCP process cannot fail the main project build.
  -->
  <Target
    Name="PublishJeekWindowsOptimizerMcpAfterBuild"
    AfterTargets="CreateNestedAppHostAfterBuild"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <JeekWindowsOptimizerMcpDir>$([System.IO.Path]::GetFullPath('$(_NestedRuntimeDir)', '$(MSBuildProjectDirectory)'))</JeekWindowsOptimizerMcpDir>
      <_McpUnlockExe>$([System.IO.Path]::Combine('$(JeekWindowsOptimizerMcpDir)', 'JeekWindowsOptimizerMcp.exe'))</_McpUnlockExe>
      <_McpUnlockStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff'))</_McpUnlockStamp>
    </PropertyGroup>
    <Exec
      Condition="Exists('$(_McpUnlockExe)')"
      Command="move /Y &quot;$(_McpUnlockExe)&quot; &quot;$(_McpUnlockExe).$(_McpUnlockStamp).old&quot;"
      IgnoreExitCode="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low" />
    <ItemGroup>
      <_McpUnlockOld Include="$(JeekWindowsOptimizerMcpDir)\JeekWindowsOptimizerMcp.exe.*.old" />
    </ItemGroup>
    <Delete Files="@(_McpUnlockOld)" TreatErrorsAsWarnings="true" ContinueOnError="true" />
    <MSBuild
      Projects="..\tools\JeekWindowsOptimizerMcp\JeekWindowsOptimizerMcp.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(JeekWindowsOptimizerMcpDir)" />
  </Target>

  <Target
    Name="PublishJeekWindowsOptimizerMcpAfterPublish"
    AfterTargets="CreateNestedAppHostAfterPublish"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <JeekWindowsOptimizerMcpDir>$([System.IO.Path]::GetFullPath('$(_PublishRuntimeDir)', '$(MSBuildProjectDirectory)'))</JeekWindowsOptimizerMcpDir>
      <_McpUnlockExe>$([System.IO.Path]::Combine('$(JeekWindowsOptimizerMcpDir)', 'JeekWindowsOptimizerMcp.exe'))</_McpUnlockExe>
      <_McpUnlockStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmssfff'))</_McpUnlockStamp>
    </PropertyGroup>
    <Exec
      Condition="Exists('$(_McpUnlockExe)')"
      Command="move /Y &quot;$(_McpUnlockExe)&quot; &quot;$(_McpUnlockExe).$(_McpUnlockStamp).old&quot;"
      IgnoreExitCode="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low" />
    <ItemGroup>
      <_McpUnlockOld Include="$(JeekWindowsOptimizerMcpDir)\JeekWindowsOptimizerMcp.exe.*.old" />
    </ItemGroup>
    <Delete Files="@(_McpUnlockOld)" TreatErrorsAsWarnings="true" ContinueOnError="true" />
    <MSBuild
      Projects="..\tools\JeekWindowsOptimizerMcp\JeekWindowsOptimizerMcp.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(JeekWindowsOptimizerMcpDir)" />
  </Target>
</Project>
